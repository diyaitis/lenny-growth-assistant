# Copy this file to .env and fill in what you need.
#   docker compose:  cp .env.example .env
#   local (no docker): cp .env.example backend/.env
#
# Every variable has a safe default that lets the app boot; nothing here is a
# secret that ships with real values. See README.md for the model setup guide.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (required)
# Docker Compose sets this automatically to point at the `db` service.
# For a no-Docker local run without Postgres, you can use:
#   DATABASE_URL=sqlite+aiosqlite:///./dev.db
# but retrieval quality will be worse (see README > "Running without Docker").
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny_growth

# ---------------------------------------------------------------------------
# LLM provider toggle (required)
# One of: anthropic | ollama | openai
# `ollama` is what the take-home demo must run with — no API key needed.
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
# Optional: if the primary provider is unreachable, fall back to this one
# instead of returning a degraded canned response. Leave unset to disable.
# LLM_FALLBACK_PROVIDER=ollama

# --- Anthropic (optional cloud provider) ---
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI (optional second cloud provider) ---
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (required for the mandatory local demo) ---
# Run `ollama serve` on the host, then `ollama pull llama3.2:3b` and
# `ollama pull nomic-embed-text` before starting the app.
#
# llama3.2:3b (not llama3.1:8b) is the default here because it's the one
# actually verified end-to-end on CPU-only hardware during development:
# 8b produced correct, grounded, well-cited answers too, but its generation
# speed on a laptop CPU (~3-5 tok/sec either way, 8b's bigger prompt-eval
# cost compounds it) pushed a single QA turn's total latency past what's
# practical to sit through live. If you have a GPU or just faster/more CPU,
# llama3.1:8b (or bigger) is a straight drop-in upgrade — swap the value
# below and restart, no code changes.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# On a CPU-only laptop, expect real latency: measured ~3-5 tokens/sec
# generation AND prompt-eval on modest hardware, so a grounded QA turn with
# a ~1,700-token retrieved context can still take 30-90+ seconds even on the
# smaller model — and the Ship 30 skill's ~1,250-word essays need enough
# budget (see SHIP30_MAX_OUTPUT_TOKENS below) that 300s is what it actually
# took in testing, not a padded-for-safety guess. If you're seeing timeouts,
# raise this further, drop RETRIEVAL_TOP_K (shorter prompts), or drop the
# token budgets below — see README > Troubleshooting.
LLM_TIMEOUT_SECONDS=300
# Measured live: an uncapped/high token budget let one under-confident QA
# answer ramble long enough on CPU-only hardware to take minutes (2000
# tokens at ~5 tok/sec is 400s+). 600 is enough for a normal QA answer;
# raise it for GPU-backed inference where token budget isn't the
# bottleneck. Ship 30 essays and generated artifacts are long-form by
# design and get their own, larger budgets below rather than sharing this
# one, so tuning one doesn't silently truncate the other.
LLM_MAX_OUTPUT_TOKENS=600
SHIP30_MAX_OUTPUT_TOKENS=1800
ARTIFACT_MAX_OUTPUT_TOKENS=2500

# ---------------------------------------------------------------------------
# Retrieval / RAG tuning (optional — defaults are sane)
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=6
# Calibrated against real nomic-embed-text scores, not guessed: a genuinely
# relevant chunk scored 0.71-0.76 in testing; a deliberately unrelated
# question against the same corpus still scored 0.47-0.54 — well above a
# naive 0.15 floor, which would have let the assistant confidently "answer"
# a question the corpus doesn't actually cover. 0.35 sits in the real gap
# between those two clusters for this embedding model.
RETRIEVAL_MIN_SCORE=0.35
CHUNK_TARGET_TOKENS=280
CHUNK_OVERLAP_TOKENS=40
EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Ship 30 for 30 skill (optional)
# ---------------------------------------------------------------------------
SHIP30_TARGET_WORDS=1250

# ---------------------------------------------------------------------------
# Frontend (used by docker-compose / Vite)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
